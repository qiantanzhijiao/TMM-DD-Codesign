__pycache__/
*.py[cod]
*.aux
*.log
# LaTeX build logs are ignored, but the SCAPS diagnostic logs are primary
# evidence for the convergence cut-offs quoted in the manuscript and must ship.
!scaps_run/export/*.log
*.out
*.spl
*.toc
_build/
.venv/
.pytest_cache/
*.egg-info/
.DS_Store
Thumbs.db
# Office owner/lock files created while a .docx/.xlsx is open in Word/Excel.
~$*
